PUBLISH_PASSWORD=#your password
# 1 si un proxy (Traefik…) est placé devant le serveur : l'IP du client est lue dans X-Forwarded-For
TRUST_PROXY=1
# Compte admin, créé au premier démarrage s'il n'existe pas. Sans ces valeurs, il n'y a pas d'admin.
# Elles peuvent être retirées une fois le compte créé.
ADMIN_EMAIL=#your e-mail
ADMIN_PASSWORD=#8 characters at least
