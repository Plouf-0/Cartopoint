{
  "name": "inventaire-botanique",
  "version": "1.3.4",
  "description": "Cartopoint : des fiches et leur position sur un plan, placement par les élèves, correction et compte rendu.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.mjs --root src --data .dev-data --port 8080",
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs --root dist --data data",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:coverage": "node scripts/coverage.mjs",
    "test:mutants": "node scripts/mutants.mjs",
    "test:charge": "node scripts/charge.mjs",
    "convert": "node scripts/convert-project.mjs",
    "captures": "node scripts/captures.mjs",
    "format": "prettier --write \"src/**/*.js\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright": "1.64.1",
    "prettier": "3.3.3"
  }
}
