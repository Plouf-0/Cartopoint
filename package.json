{
  "name": "inventaire-botanique",
  "version": "1.0.0",
  "description": "Inventaire botanique sur plan : fiches d'espèces, placement par les élèves, correction et compte rendu.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node server/server.mjs --root src --data data --port 8080",
    "build": "node scripts/build.mjs",
    "start": "node server/server.mjs --root dist --data data",
    "test": "node --test tests/*.test.js",
    "convert": "node scripts/convert-project.mjs",
    "format": "prettier --write \"src/**/*.js\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "prettier": "3.3.3"
  }
}
